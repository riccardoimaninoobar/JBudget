<?xml version="1.0" encoding="UTF-8"?>

<!-- File FXML per la finestra principale dell'applicazione -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- BorderPane come contenitore principale con aree divise -->
<!-- Collegato al controller principale MainController -->
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.jbudget123012.controller.MainController">
    <left>
        <!-- Menu di navigazione verticale a sinistra con VBox -->
        <VBox prefWidth="180.0" spacing="10.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">
            <children>
                <!-- Pulsanti per cambiare la vista centrale -->
                <!-- Ogni bottone usa maxWidth molto grande per occupare tutta la larghezza -->
                <Button maxWidth="1.7976931348623157E308" onAction="#showTransactionsView" text="Movimenti">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" onAction="#showTagsView" text="Gestione Tag">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" onAction="#showBudgetView" text="Gestione Budget">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" onAction="#showDeadlinesView" text="Scadenzario">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" onAction="#showStatisticsView" text="Statistiche">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                <!-- Bottone per la vista Piani a Rate senza font specifico e senza maxWidth -->
                <!-- Potrebbe essere migliorato per coerenza stilistica -->
                <Button text="Piani a Rate" onAction="#showInstallmentView" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </left>
    <center>
        <!-- Area centrale dove il controller inserisce le viste dinamiche -->
        <BorderPane fx:id="mainContentArea" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
