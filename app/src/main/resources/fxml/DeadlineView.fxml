<?xml version="1.0" encoding="UTF-8"?>

<!-- questo file definisce l'interfaccia per la gestione delle scadenze -->
<!-- un borderpane è ottimo per dividere la schermata in sezioni logiche -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!-- colleghiamo la vista al suo controller che ne gestirà la logica -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.jbudget123012.controller.DeadlineController">
    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Scadenze" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <TableView fx:id="deadlinesTableView">
                <columns>
                    <!-- ogni fx:id qui corrisponde a un campo nel deadlinecontroller -->
                    <TableColumn fx:id="descriptionColumn" prefWidth="250.0" text="Descrizione" />
                    <TableColumn fx:id="amountColumn" prefWidth="100.0" text="Importo" />
                    <TableColumn fx:id="dueDateColumn" prefWidth="100.0" text="Data Scadenza" />
                    <TableColumn fx:id="tagsColumn" prefWidth="150.0" text="Tag Associati" />
                    <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Stato" />
                </columns>
                <!-- questa policy fa in modo che le colonne riempiano tutto lo spazio disponibile -->
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                <!-- i bottoni sono disabilitati all'inizio e verranno attivati dal controller -->
                <Button fx:id="markAsPaidButton" onAction="#handleMarkAsPaid" text="Segna come Pagato" disable="true" />
                <Button fx:id="deleteButton" onAction="#handleDelete" text="Elimina Selezionato" style="-fx-background-color: #ff6666;" textFill="white" disable="true" />
            </HBox>
        </VBox>
    </center>
    <bottom>
        <!-- questa è la sezione per creare una nuova scadenza -->
        <VBox spacing="10" style="-fx-padding: 15; -fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
            <Label text="Nuova Scadenza:" style="-fx-font-weight: bold;" />
            <!-- un gridpane è perfetto per allineare le etichette con i campi di testo -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <children>
                    <Label text="Descrizione:" GridPane.rowIndex="0" />
                    <TextField fx:id="descriptionField" promptText="Es. Bolletta luce" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Importo (€):" GridPane.rowIndex="1" />
                    <TextField fx:id="amountField" promptText="Es. 55.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Data Scadenza:" GridPane.rowIndex="2" />
                    <DatePicker fx:id="dueDatePicker" promptText="Seleziona data" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Associa Tag:" GridPane.rowIndex="3" />
                    <!-- una listview per permettere la selezione di uno o più tag -->
                    <ListView fx:id="tagsListView" prefHeight="80.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <!-- onaction collega il click del bottone a un metodo nel controller -->
                        <Button onAction="#handleCreateDeadline" text="Crea Scadenza" />
                    </HBox>
                </children>
            </GridPane>
        </VBox>
    </bottom>
</BorderPane>